# All of these are read server-side only (no NEXT_PUBLIC_ prefix), so keys never reach the browser.

# --- Token ---
# Token contract address. Optional: defaults to "contract" in content/site.json.
TOKEN_ADDRESS=
# Optional: limit DexScreener pools to one chain (ethereum | base | arbitrum ...). Empty = all chains.
DEXSCREENER_CHAIN=
# Token ticker shown in the UI
TOKEN_SYMBOL=WEI

# --- Holders ---
# "etherscan" (Etherscan V2 multichain API, tokenholdercount needs an API Pro plan)
# or "blockscout" (free, no key: set BLOCKSCOUT_URL e.g. https://eth.blockscout.com or https://base.blockscout.com)
HOLDERS_PROVIDER=blockscout
BLOCKSCOUT_URL=https://eth.blockscout.com

# --- Explorer (Etherscan V2: one key works across chains) ---
ETHERSCAN_API_KEY=
# EVM chain id for Etherscan V2: 1 = Ethereum, 8453 = Base, 42161 = Arbitrum
EXPLORER_CHAIN_ID=1

# --- Fees ---
# Wallet / contract that collects the trading fees.
# "Fees collected" = total ETH received by this address, "ETH distributed" = total ETH sent out of it.
# Stockify index for WEI: 0xa0cb7a7a4beb0b4bb819637a961c1dfe9bee3507 (confirm it is the address that receives/sends the ETH)
FEE_WALLET=0xa0cb7a7a4beb0b4bb819637a961c1dfe9bee3507
# Optional manual overrides (in ETH) if fees/distributions don't flow through a single wallet.
FEES_COLLECTED_ETH_OVERRIDE=
ETH_DISTRIBUTED_ETH_OVERRIDE=

# --- Wei vitality ---
# 24h transaction count that maps to 100% vitality
VITALITY_MAX_TXNS=1000
